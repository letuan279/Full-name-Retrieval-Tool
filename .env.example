# Full-name Retrieval Tool - Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Information
VITE_APP_NAME="Full-name Retrieval Tool"
VITE_APP_VERSION="2.0.0"
VITE_APP_DESCRIPTION="Tool to extract names from transaction messages and find corresponding students"

# API Configuration
# Groq API Keys (separate keys, numbered sequentially)
VITE_API_KEY_1="your_first_groq_api_key"
VITE_API_KEY_2="your_second_groq_api_key"
VITE_API_KEY_3="your_third_groq_api_key"
# Add more keys as needed: VITE_API_KEY_4, VITE_API_KEY_5, etc.

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=false

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_MAX_BATCH_SIZE=10

# Performance Settings
VITE_DEBOUNCE_DELAY=200
VITE_RETRY_ATTEMPTS=3

# Debug Configuration (only for development)
VITE_LOG_LEVEL=info
VITE_ENABLE_PERFORMANCE_LOGGING=false
VITE_ENABLE_API_LOGGING=false

# Note: All VITE_ prefixed variables will be exposed to the client-side code
# Never put sensitive information that shouldn't be public in VITE_ variables
